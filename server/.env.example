PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://cfujam:cfujam_secret@localhost:5432/cfujam_db?schema=public

# Security / JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-jam2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://perrarancino.github.io

# Default Jam Slug (for backwards compatibility with single-jam frontend)
DEFAULT_JAM_SLUG=cfu-game-jam-2026

# Storage / MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cfujam-builds
S3_REGION=us-east-1
